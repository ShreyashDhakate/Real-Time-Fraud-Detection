# Docker Compose loads this file after it is copied to .env.
# Keep 1 for the explicitly labeled untrained local demo; use 0 for a trained model.
ALLOW_DEMO_MODEL=1
GRAFANA_PORT=3000
SCORER_METRICS_PORT=8000
